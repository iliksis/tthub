{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"assist": {
		"actions": { "source": { "organizeImports": "on", "useSortedKeys": "on" } }
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"*.js",
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.js",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/lib/prisma/**/*",
			"!**/src/paraglide/**/*",
			"**/e2e/*.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "auto"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": [
				"src/api/invitations.ts",
				"src/api/labels.ts",
				"src/api/passwordReset.ts",
				"src/api/placements.ts",
				"src/api/players.ts",
				"src/api/seasons.ts",
				"src/api/stats.ts",
				"src/api/teams.ts",
				"src/api/users.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@/lib/db": "Handler files delegate to their API class (src/api/<aggregate>.server.ts); Prisma access lives there. See ADR 0004.",
									"@/lib/session": "Handler files delegate to their API class; auth is the class's static policy. See ADR 0004."
								},
								"patterns": [
									{
										"group": ["@/lib/prisma/**", "@prisma/**"],
										"message": "Handler files delegate to their API class (src/api/<aggregate>.server.ts); Prisma access lives there. See ADR 0004."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": false,
		"useIgnoreFile": false
	}
}
