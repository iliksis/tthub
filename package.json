{
  "name": "tthub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set NODE_OPTIONS=--import ./instrument.server.mjs && vite dev --port 3000",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "serve": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:e2e:setup": "npm run test:e2e:db:reset && npm run test:e2e:db:seed",
    "test:e2e:db:reset": "set DATABASE_URL=file:./prisma/test.db && npx prisma migrate deploy",
    "test:e2e:db:seed": "set DATABASE_URL=file:./prisma/test.db && npx tsx prisma/seed.ts",
    "test:e2e:server": "set DATABASE_URL=file:./prisma/test.db && set NODE_OPTIONS=--import ./instrument.server.mjs && vite dev --port 3001",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:reset": "dotenv -e .env.local -- prisma migrate reset",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:format": "dotenv -e .env.local -- prisma format",
    "generateVapidKeys": "node --import ./generateVapidKeys.js",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/tanstackstart-react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-devtools": "0.8.4",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.139.3",
    "@tanstack/react-router-devtools": "1.139.3",
    "@tanstack/react-router-ssr-query": "1.139.3",
    "@tanstack/react-start": "1.139.3",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "1.139.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "lucide-react": "0.562.0",
    "mustache": "4.2.0",
    "node-device-detector": "2.2.5",
    "open-holiday-js": "1.0.3",
    "prisma": "^7.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "vite-tsconfig-paths": "5.1.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@catppuccin/tailwindcss": "1.0.0",
    "@flydotio/dockerfile": "0.7.10",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "0.3.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/mustache": "4.2.6",
    "@types/node": "24.10.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "5.1.2",
    "dotenv-cli": "11.0.0",
    "jsdom": "27.4.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-mkcert": "1.17.9",
    "vitest": "4.0.17",
    "web-vitals": "5.1.0"
  },
  "overrides": {
    "magicast": "0.3.5"
  }
}
