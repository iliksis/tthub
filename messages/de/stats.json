{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"stats_no_seasons": "Keine Saisons vorhanden",
	"stats_no_teams_in_this_season": "Keine Teams in dieser Saison",
	"stats_no_tournaments_in_this_season": "Keine Turniere in dieser Saison",
	"stats_player_count": "Spieler:innen",
	"stats_player_count_over_seasons": "Spielerzahl im Saisonvergleich",
	"stats_stats_found": "Statistik gefunden",
	"stats_statistics": "Statistik",
	"stats_teams_league_and_placement": "Ligen & Platzierungen",
	"stats_this_season": "Diese Saison",
	"stats_tournament_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural"
			],
			"selectors": [
				"countPlural"
			],
			"match": {
				"countPlural=one": "{count} Turnier",
				"countPlural=other": "{count} Turniere"
			}
		}
	],
	"stats_tournament_series_and_placements": "Turnierserien & Platzierungen"
}
