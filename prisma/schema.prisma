generator client {
  provider   = "prisma-client"
  output     = "../src/lib/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                   String                 @id @default(nanoid(6))
  userName             String                 @unique
  password             String?
  name                 String
  role                 Role                   @default(USER)
  feedId               String                 @unique @default(uuid())
  invitation           UserInvitation?
  responses            Response[]
  subscriptions        Subscription[]
  notificationSettings NotificationSettings[]
  passwordReset        PasswordReset?
  feedConfig           FeedConfig?
  transactions         Transaction[]
  mutedLabels          UserMutedLabel[]
}

enum Role {
  USER
  EDITOR
  ADMIN
}

model FeedConfig {
  id                      String           @id @default(uuid())
  userId                  String           @unique
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  includeResponseTypes    String?          // Comma-separated: ACCEPT,MAYBE,DECLINE
  includeDraftStatus      Boolean          @default(false)
  includeAppointmentTypes String?          // Comma-separated: TOURNAMENT,HOLIDAY,TEAM_MATCH
  excludeLabelIds         String?          // Comma-separated Label ids — exclude only, no include-by-label
}

model UserInvitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordReset {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
}

model Appointment {
  id                   String             @id @default(nanoid(6))
  createdAt            DateTime           @default(now())
  deletedAt            DateTime?
  startDate            DateTime
  endDate              DateTime?
  title                String
  location             String?
  link                 String?
  type                 AppointmentType
  status               AppointmentStatus?
  responses            Response[]
  placements           Placement[]
  nextAppointmentId    String?
  nextAppointment      Appointment?       @relation("AppointmentSeries", fields: [nextAppointmentId], references: [id])
  previousAppointments Appointment[]      @relation("AppointmentSeries")
  transactions         Transaction[]
  ownTeamId            String?
  ownTeam              Team?              @relation(fields: [ownTeamId], references: [id], onDelete: SetNull)
  homeTeam             String?
  awayTeam             String?
  // Nullable: HOLIDAY appointments (club-wide closures) don't necessarily
  // belong to one competitive season and can span a season boundary. All
  // other appointment types require it, enforced in the API layer.
  seasonId             String?
  season               Season?            @relation(fields: [seasonId], references: [id])
  labels               AppointmentLabel[]
}

model Season {
  id           String        @id @default(nanoid(6))
  createdAt    DateTime      @default(now())
  name         String
  isActive     Boolean       @default(false)
  teams        Team[]
  appointments Appointment[]
  teamPlayers  TeamPlayer[]
}

enum AppointmentStatus {
  DRAFT
  PUBLISHED
}

enum AppointmentType {
  TOURNAMENT
  HOLIDAY
  TEAM_MATCH
}

// Editor-managed tag attachable to TOURNAMENT appointments (e.g. region,
// coach relevance). Purely informational — see docs/adr/0002.
model Label {
  id           String             @id @default(nanoid(6))
  createdAt    DateTime           @default(now())
  name         String
  color        String
  // Editor-set rank via drag-and-drop on the label management page. Lower
  // value = higher priority (0 is top of the list). Determines which of an
  // appointment's Labels wins when a single color is needed (calendar bar,
  // iCal COLOR) — see resolveTopPriorityLabel in src/lib/labelColor.ts.
  // Not enforced unique at the DB level: reorderLabels/createLabel always
  // write a contiguous 0..n-1 sequence, so duplicates can't arise in practice.
  priority       Int                @default(0)
  appointments   AppointmentLabel[]
  mutedBy        UserMutedLabel[]
}

model AppointmentLabel {
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  labelId       String
  label         Label       @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([appointmentId, labelId])
}

// A user's personal notification-mute set (see CONTEXT.md's "Muted Label") —
// a Label they've chosen to suppress from their own push notifications, read
// by src/api/notifications.ts's sendNotification. The calendar feed's
// exclude-by-label filtering is a separate, independently configured list
// (FeedConfig.excludeLabelIds below) — the two are not the same preference
// and can be set differently.
model UserMutedLabel {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([userId, labelId])
}

model Response {
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])
  responseType  ResponseType

  @@id([userId, appointmentId])
}

enum ResponseType {
  ACCEPT
  MAYBE
  DECLINE
}

model Player {
  id         String       @id @default(nanoid(6))
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  name       String
  year       Int
  qttr       Int
  gender     Gender?
  teams      TeamPlayer[]
  placements Placement[]
}

enum Gender {
  MALE
  FEMALE
}

model Team {
  id             String        @id @default(nanoid(6))
  createdAt      DateTime      @default(now())
  title          String
  league         String?
  placement      String?
  clickTTGroupId String?
  seasonId       String
  season         Season        @relation(fields: [seasonId], references: [id])
  players        TeamPlayer[]
  appointments   Appointment[]
  standings      Standing[]

  @@unique([clickTTGroupId, seasonId])
}

model TeamPlayer {
  id        String   @id @default(nanoid(6))
  createdAt DateTime @default(now())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
}

model Standing {
  id          String   @id @default(nanoid(6))
  updatedAt   DateTime @updatedAt
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rank        Int
  teamName    String
  wins        Int
  draws       Int
  undecided   Int
  losses      Int
  matchesWon  Int
  matchesLost Int
  diff        Int
  pointsWon   Int
  pointsLost  Int

  @@unique([teamId, teamName])
}

model Placement {
  createdAt     DateTime    @default(now())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  category      String
  placement     String?

  @@id([playerId, appointmentId, category])
}

model Transaction {
  id            String          @id @default(nanoid(6))
  createdAt     DateTime        @default(now())
  appointmentId String
  appointment   Appointment     @relation(fields: [appointmentId], references: [id])
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          TransactionType
  changes       Json?
}

enum TransactionType {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

model Subscription {
  id                   String                 @id @default(uuid())
  userId               String
  user                 User                   @relation(fields: [userId], references: [id])
  device               String
  endpoint             String
  p256dh               String                 @unique
  auth                 String                 @unique
  notificationSettings NotificationSettings[]
}

model ImporterSetting {
  importerId String  @id
  enabled    Boolean @default(true)
}

model NotificationSettings {
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  subscriptionId     String
  subscription       Subscription @relation(fields: [subscriptionId], references: [id])
  newAppointment     Boolean
  changedAppointment Boolean

  @@id([userId, subscriptionId])
}
